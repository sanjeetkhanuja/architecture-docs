        <mxCell id="dns" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=12;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;" value="DNS&lt;br&gt;Primary value: GCP Global Load Balancer&lt;br&gt;Secondary value: Azure Global Load Balancer" vertex="1">
          <mxGeometry height="120" width="280" x="400" y="114" as="geometry" />
        </mxCell>
        <mxCell id="notes" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingTop=4;fillColor=#FFFDE7;strokeColor=#D6B656;" value="&lt;b&gt;Key design points&lt;/b&gt;&lt;br&gt;• DNS primary value points to GCP; secondary value points to Azure. If the GCP load balancer is not reachable, requests go to Azure.&lt;br&gt;• UI and backend run in two regions (US and EU) in both clouds; the global load balancer uses region affinity.&lt;br&gt;• Cloud-agnostic components (Kubernetes, Postgres, observability stack) are used wherever possible. Eventing and object storage are cloud-native.&lt;br&gt;• Postgres runs in the US region only; a nightly sync copies GCP Postgres to Azure Postgres.&lt;br&gt;• Azure is the secondary cloud: minimum resource configuration, receives traffic only when GCP is unavailable." vertex="1">
          <mxGeometry height="105" width="750" x="1290" y="35" as="geometry" />
        </mxCell>
        <mxCell id="gcp" parent="1" style="swimlane;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;startSize=30;fillColor=#E8F0FE;strokeColor=#4285F4;" value="Google Cloud Platform (GCP) - PRIMARY (Active)" vertex="1">
