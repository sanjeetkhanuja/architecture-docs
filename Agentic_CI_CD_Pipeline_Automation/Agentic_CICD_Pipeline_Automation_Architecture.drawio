  <diagram id="p2" name="2 - CI Agent">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1060" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p2-title" value="CI Agent (ci-agent) — classify, generate, deliver, watch and repair a CI pipeline" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="10" width="1500" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p2-A" value="&lt;b&gt;A. ci-agent authoring flow — classify → discover → extract → render → lint → push / open PR → watch → diagnose → repair&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=2;fillColor=#fafafa;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="30" y="60" width="1740" height="470" as="geometry" />
        </mxCell>
        <mxCell id="p2-B" value="&lt;b&gt;B. Generated CI pipeline — executes on the target platform (GitHub Actions / GitLab CI runner)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=2;fillColor=#fafafa;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="30" y="590" width="1740" height="330" as="geometry" />
        </mxCell>
        <mxCell id="p2-llm1" value="&lt;b&gt;LLM (Claude API)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;generates a template when none matches (planned / fallback)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="100" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p2-lib" value="&lt;b&gt;Jinja2 template library&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&amp;lt;stack&amp;gt;-&amp;lt;platform&amp;gt;-v1.yml&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1000" y="100" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p2-valid" value="&lt;b&gt;Validators&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;yamllint · actionlint · glab ci lint · GitLab CI Lint API · python yaml · Helm lint&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1260" y="100" width="440" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p2-a0" value="&lt;b&gt;Repository URL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;GitLab / GitHub + target CI platform&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=30;fillColor=#1f4e79;strokeColor=#0b2a47;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="50" y="190" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2-a1" value="&lt;b&gt;Clone&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;git clone --depth 1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="240" y="190" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2-a2" value="&lt;b&gt;Classify&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;.NET Core / .NET FX / COBOL / Node / Python / Spring from file-system signals (no LLM)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="430" y="190" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2-a3" value="&lt;b&gt;Discover&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;SDK, version, build tool, Helm path, test framework&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="620" y="190" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2-a4" value="&lt;b&gt;Extract&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;typed pipeline facts (stack × platform)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="810" y="190" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2-a5" value="&lt;b&gt;Resolve template&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;select a Jinja2 template, or LLM-generate one&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1000" y="190" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2-a6" value="&lt;b&gt;Render&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Helm chart + CI pipeline YAML&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1190" y="190" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2-a7" value="&lt;b&gt;Lint&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Helm lint + CI YAML validators&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1380" y="190" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2-a8" value="&lt;b&gt;Push / open PR-MR&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;branch + PR / MR for human review&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1570" y="190" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2-llm2" value="&lt;b&gt;LLM (Claude API)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;diagnose and patch (planned / fallback)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1190" y="310" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2-a10" value="&lt;b&gt;Diagnose &amp;amp; repair&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;patch YAML; lint-retry loop up to 3 attempts, then escalate&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1380" y="310" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2-a9" value="&lt;b&gt;Watch&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;follow the triggered pipeline job until complete&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1570" y="310" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2-a11" value="&lt;b&gt;Human review &amp;amp; merge&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Developer approves the MR — never auto-merged&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1570" y="430" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2-a12" value="&lt;b&gt;CD handoff descriptor&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;consumed by cd-agent for per-app / per-env values&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1380" y="430" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2-cd" value="&lt;b&gt;CD Agent&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;see page 3&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="1190" y="430" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2-b1" value="&lt;b&gt;Select CI runner&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Linux / Windows / self-hosted&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="50" y="650" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2-b2" value="&lt;b&gt;Unit tests + coverage&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;.NET tests, coverage report&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="260" y="650" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2-b3" value="&lt;b&gt;SAST / SCA scan&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;security scans injected into the pipeline&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="470" y="650" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2-b4" value="&lt;b&gt;Build app&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Docker image or DLL / binaries&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="680" y="650" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2-b5" value="&lt;b&gt;SBOM + container scan&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;CycloneDX SBOM, CVE scan&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="890" y="650" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2-b6" value="&lt;b&gt;DAST scan (optional)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;dynamic scan of the running app&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1100" y="650" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2-b7" value="&lt;b&gt;Playwright E2E&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;non-blocking in CI&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1310" y="650" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2-b8" value="&lt;b&gt;Store artifacts&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;reports, SBOM, Helm chart, image&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1520" y="650" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2-t2" value="&lt;b&gt;Test &amp;amp; coverage tools&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;GitLab · SonarQube · .NET SDK&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="260" y="770" width="170" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p2-t3" value="&lt;b&gt;SAST / SCA tools&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;GitLab SAST · GitLab Dependency Scanning · Fortify ScanCentral (scaffold) · Sonatype Nexus IQ (scaffold)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="470" y="770" width="170" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p2-t5" value="&lt;b&gt;SBOM &amp;amp; container tools&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;syft → CycloneDX · grype / trivy · GitLab Container Scanning · Wiz (scaffold)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="890" y="770" width="170" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p2-t6" value="&lt;b&gt;DAST tools&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;GitLab DAST · Fortify WebInspect (scaffold)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1100" y="770" width="170" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p2-t7" value="&lt;b&gt;E2E tools&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Playwright in an ephemeral container, auto teardown&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="1310" y="770" width="170" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p2-t8" value="&lt;b&gt;Generated artifacts&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;unit test results · SAST / DAST / SCA reports · container scan report · SBOM · Helm chart package · Docker image · binaries&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
