  <diagram id="p3" name="3 - CD Agent">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1020" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p3-title" value="CD Agent (cd-agent) — author a blue/green pipeline, raise one human-approved PR, gate and roll back" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="10" width="1500" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p3-A" value="&lt;b&gt;Authoring — stages 1–5 never touch a cluster (ADR-CD-001 v2)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=2;fillColor=#fafafa;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="30" y="60" width="1740" height="210" as="geometry" />
        </mxCell>
        <mxCell id="p3-B" value="&lt;b&gt;Runtime — stages 6–8 are no-ops unless CD_LOCAL_DEPLOY=1 and not --dry-run; each still writes a &quot;skipped&quot; result&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=2;fillColor=#fafafa;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="30" y="340" width="1740" height="400" as="geometry" />
        </mxCell>
        <mxCell id="p3-R" value="&lt;b&gt;Registries and design notes&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=2;fillColor=#fafafa;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="30" y="780" width="1740" height="200" as="geometry" />
        </mxCell>
        <mxCell id="p3-ci" value="&lt;b&gt;CI Agent&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;see page 2&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="50" y="130" width="130" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p3-ho" value="&lt;b&gt;CI handoff&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;descriptor.json&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=30;fillColor=#1f4e79;strokeColor=#0b2a47;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="210" y="130" width="140" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p3-s1" value="&lt;b&gt;1. Gather&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;descriptor → deploy_context.json&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="380" y="130" width="150" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p3-s2" value="&lt;b&gt;2. Resolve template&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;→ template_ref.json&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="565" y="130" width="150" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p3-s3" value="&lt;b&gt;3. Render&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;→ rendered/ (per-app / per-env values, blue/green + health-gate manifests)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="750" y="130" width="150" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p3-s4" value="&lt;b&gt;4. Validate&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;→ validate_result.json (every gate failure path routes to rollback)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="935" y="130" width="150" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p3-s5" value="&lt;b&gt;5. Deliver&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;raise PR → return_contract.json&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1120" y="130" width="150" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p3-pr" value="&lt;b&gt;PR / MR&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;one never-merged PR — the agent never self-merges&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=30;fillColor=#1f4e79;strokeColor=#0b2a47;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="1310" y="130" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p3-dev" value="&lt;b&gt;Developer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;human in the loop approves and merges&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1530" y="130" width="150" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p3-s6" value="&lt;b&gt;6. Deploy&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;kubectl apply → runtime_manifests/&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1110" y="420" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p3-s7" value="&lt;b&gt;7. Watch&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;→ watch_result.json&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="890" y="420" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p3-s8" value="&lt;b&gt;8. Gate&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;health → DAST → Playwright → gate_result.json (all blocking)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="670" y="420" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p3-prom" value="&lt;b&gt;Promote / cutover&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;GREEN becomes live (blue/green)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="450" y="420" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p3-app" value="&lt;b&gt;Deployed app&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;GREEN live&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=30;fillColor=#1f4e79;strokeColor=#0b2a47;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="230" y="420" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p3-rb" value="&lt;b&gt;Rollback&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;kubectl argo rollouts abort — traffic stays on BLUE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="440" y="600" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p3-ch" value="&lt;b&gt;Channels&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;rollback_log.json (runtime) · exceptions.json (audit log)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="170" y="590" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p3-prov" value="&lt;b&gt;Providers (profile-selected)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;local: local-argo (kubectl + Argo Rollouts on kind) · gitea · prem-loki · mailhog&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;prod: harness · argo-rollouts · gitlab · dynatrace-splunk · ses-acs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="890" y="600" width="390" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p3-guard" value="&lt;b&gt;Guardrails&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;no_self_merge · retry_cap ≤ 3 · channel_separation · local_deploy scoped to the local profile&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1320" y="600" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p3-strat" value="&lt;b&gt;Strategy registry (default: blue-green)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;★ blue-green — exposure: none (default)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;canary — exposure: subset&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;rolling — exposure: full&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="50" y="830" width="400" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p3-gatereg" value="&lt;b&gt;Gate registry (deploy-catalog.json)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;health ✓ blocking — GET /health&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;dast ✓ blocking — ZAP (local) / Fortify (stub)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;playwright ✓ blocking — ephemeral container&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;default order: health → DAST → Playwright&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="480" y="830" width="560" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p3-note" value="&lt;b&gt;Two Playwright stages, deliberately different&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;CD gate: blocking. It runs at deploy time and its failure rolls the release back.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;CI E2E job: non-blocking. It runs inside the pipeline the CI agent authored, where the worst case is a blocked merge.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="1070" y="830" width="680" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p3-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3-ci" target="p3-ho">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3-ho" target="p3-s1">
