        <mxCell id="p1-harn" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=2;fillColor=#fafafa;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" value="" vertex="1">
