        <mxCell id="p4-title" value="Security Remediation Agent — open finding → triage → auto-generated PR → human review → merge decision" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="10" width="1500" height="36" as="geometry" />
