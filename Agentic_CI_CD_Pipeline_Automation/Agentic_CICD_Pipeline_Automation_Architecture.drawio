        </mxCell>
        <mxCell id="p4-uapi" value="&lt;b&gt;Unified API + Postgres&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;system of record — audit trail and pilot metrics&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="700" y="610" width="350" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p4-deliv" value="&lt;b&gt;Pilot deliverables&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• End-to-end demo: open finding → triage → auto-generated PR → human review → merge decision&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Triage output validated: severity + fix-pattern classification with confidence scoring&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Auto-remediation for dependency / SCA and SAST classes, plus DAST review&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Full audit log of every agent action&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Findings report with scale-readiness recommendation (more finding types, platforms, repos)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="610" width="620" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p4-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#444444;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4-s0" target="p4-s1">
