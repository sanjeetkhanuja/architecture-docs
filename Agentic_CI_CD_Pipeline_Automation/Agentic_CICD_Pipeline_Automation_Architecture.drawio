        <mxCell id="p4-s4" value="&lt;b&gt;Human-in-the-loop gate&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;reviewer approval before merge&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
