          <mxGeometry x="290" y="180" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p4-s2" value="&lt;b&gt;Triage Agent&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;classify by severity and fix pattern; score confidence&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="540" y="180" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p4-dm" value="&lt;b&gt;In scope and high confidence?&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;arcSize=6;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="790" y="175" width="170" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p4-s3" value="&lt;b&gt;Remediation Agent&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;auto-generate a fix; open a PR with rationale for in-scope patterns (dependency / SCA uplifts)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1010" y="180" width="200" height="110" as="geometry" />
