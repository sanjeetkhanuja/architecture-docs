        <mxCell id="p4-s0" value="&lt;b&gt;Open findings&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;SCA / SAST from CI Agent scans, Fortify, Sonatype IQ; COBOL scan via the client-recommended toolset (no DAST for AS400)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="200" height="110" as="geometry" />
