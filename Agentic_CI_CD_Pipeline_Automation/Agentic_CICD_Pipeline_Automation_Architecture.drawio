        <mxCell id="p1-llm" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;" value="&lt;b&gt;LLM (Claude API) — planned / fallback&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Template generation · failure diagnosis and patch · finding triage · fix generation.&amp;nbsp;&lt;/font&gt;" vertex="1">
          <mxGeometry height="52" width="430" x="600" y="235" as="geometry" />
        </mxCell>
        <mxCell id="p1-sec" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=6;" value="&lt;b&gt;Security Remediation Agent&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Triage Agent: severity + fix pattern + confidence score&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Low-confidence findings → manual review&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Remediation Agent: auto-fix + PR with rationale (dependency / SCA uplifts)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Full audit log of every action&lt;/font&gt;" vertex="1">
          <mxGeometry height="140" width="250" x="360" y="410" as="geometry" />
        </mxCell>
        <mxCell id="p1-ci" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=6;" value="&lt;b&gt;CI Agent (ci-agent)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;classify → discover → extract → render → lint → push / open PR → watch → diagnose → repair&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Classifies the stack from file-system signals&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Renders a Jinja2 template (or LLM-generates one) and lints it&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Opens a PR / MR — never auto-merges&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Watches the run; diagnoses and patches&amp;nbsp;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Emits the CD handoff descriptor&lt;/font&gt;" vertex="1">
          <mxGeometry height="140" width="250" x="690" y="410" as="geometry" />
        </mxCell>
        <mxCell id="p1-cd" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=6;" value="&lt;b&gt;CD Agent (cd-agent)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;gather → resolve_template → render → validate → deliver → deploy → watch / gate&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Short-lived, stateless authoring job&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Blue/green + health-gate manifests per app / env&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Validates that every gate failure routes to rollback&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Raises exactly one never-merged PR&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;• Runtime gates: health → DAST → Playwright&amp;nbsp;&lt;/font&gt;" vertex="1">
          <mxGeometry height="140" width="250" x="1020" y="410" as="geometry" />
        </mxCell>
        <mxCell id="p1-hitl" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;Human-in-the-loop gate&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;A reviewer approves every PR / MR before merge — agents never self-merge. Low-confidence findings go to manual review.&lt;/font&gt;" vertex="1">
          <mxGeometry height="56" width="950" x="340" y="670" as="geometry" />
        </mxCell>
